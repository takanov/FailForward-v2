<div class="container-fluid">
  <div class="row">
    <%# サイドバー（統計とフィルター） %>
    <div class="col-lg-3 d-none d-lg-block">
      <div class="sticky-top" style="top: 20px;">
        <h5 class="mb-3">
          <i class="bi bi-bar-chart"></i> 統計
        </h5>

        <%# 統計カード %>
        <div class="mb-2">
          <div class="card border-0 shadow-sm">
            <div class="card-body py-2">
              <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted">総数</span>
                <span class="badge bg-primary rounded-pill"><%= @stats[:total] %></span>
              </div>
            </div>
          </div>
        </div>

        <div class="mb-2">
          <div class="card border-0 shadow-sm">
            <div class="card-body py-2">
              <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted">進行中</span>
                <span class="badge bg-warning rounded-pill"><%= @stats[:pending] %></span>
              </div>
            </div>
          </div>
        </div>

        <div class="mb-2">
          <div class="card border-0 shadow-sm">
            <div class="card-body py-2">
              <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted">完了</span>
                <span class="badge bg-success rounded-pill"><%= @stats[:completed] %></span>
              </div>
            </div>
          </div>
        </div>

        <div class="mb-4">
          <div class="card border-0 shadow-sm">
            <div class="card-body py-2">
              <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted">期限切れ</span>
                <span class="badge bg-danger rounded-pill"><%= @stats[:overdue] %></span>
              </div>
            </div>
          </div>
        </div>

        <%# フィルター %>
        <h5 class="mb-3">
          <i class="bi bi-funnel"></i> フィルター
        </h5>
        <div class="list-group mb-4">
          <%= link_to failures_path, class: "list-group-item list-group-item-action #{'active' if params[:filter].nil?}" do %>
            <i class="bi bi-grid-3x3"></i> すべて
          <% end %>
          <%= link_to failures_path(filter: "pending"), class: "list-group-item list-group-item-action #{'active' if params[:filter] == 'pending'}" do %>
            <i class="bi bi-hourglass-split"></i> 進行中
          <% end %>
          <%= link_to failures_path(filter: "completed"), class: "list-group-item list-group-item-action #{'active' if params[:filter] == 'completed'}" do %>
            <i class="bi bi-check-circle"></i> 完了
          <% end %>
          <%= link_to failures_path(filter: "overdue"), class: "list-group-item list-group-item-action #{'active' if params[:filter] == 'overdue'}" do %>
            <i class="bi bi-exclamation-triangle"></i> 期限切れ
          <% end %>
        </div>

        <%# ソート %>
        <h5 class="mb-3">
          <i class="bi bi-sort-down"></i> 並び順
        </h5>
        <div class="list-group">
          <%= link_to failures_path(filter: params[:filter], search: params[:search]), class: "list-group-item list-group-item-action #{'active' if params[:sort].nil?}" do %>
            <i class="bi bi-clock"></i> 作成日
          <% end %>
          <%= link_to failures_path(filter: params[:filter], search: params[:search], sort: "priority"), class: "list-group-item list-group-item-action #{'active' if params[:sort] == 'priority'}" do %>
            <i class="bi bi-flag"></i> 優先度
          <% end %>
          <%= link_to failures_path(filter: params[:filter], search: params[:search], sort: "due_date"), class: "list-group-item list-group-item-action #{'active' if params[:sort] == 'due_date'}" do %>
            <i class="bi bi-calendar"></i> 期限
          <% end %>
        </div>
      </div>
    </div>

    <%# メインタイムライン %>
    <div class="col-lg-6 col-md-8 mx-auto px-0">
      <%# ヘッダー %>
      <div class="timeline-header border-bottom bg-white sticky-top">
        <div class="p-3">
          <h4 class="mb-0">失敗タイムライン</h4>
        </div>
      </div>

      <%# 検索バー %>
      <div class="p-3 bg-light border-bottom">
        <%= form_with(url: failures_path, method: :get, local: true, class: "position-relative") do |f| %>
          <i class="bi bi-search position-absolute" style="left: 25px; top: 50%; transform: translateY(-50%);"></i>
          <%= f.text_field :search, value: params[:search], placeholder: "失敗内容を検索...", class: "form-control ps-5" %>
        <% end %>
      </div>

      <%# タイムライン %>
      <% if @failures.any? %>
        <% @failures.each do |failure| %>
          <div class="timeline-item border-bottom bg-white">
            <div class="p-3">
              <div class="d-flex">
                <%# アバター %>
                <div class="flex-shrink-0 me-3">
                  <div class="avatar bg-<%= failure.priority_class %> text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <%= failure.user.name[0] %>
                  </div>
                </div>

                <%# コンテンツ %>
                <div class="flex-grow-1">
                  <%# ユーザー名と日時 %>
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                      <strong><%= failure.user.name %></strong>
                      <span class="text-muted ms-2">
                        · <%= time_ago_in_words(failure.created_at) %>前
                      </span>
                    </div>
                    <div>
                      <span class="badge bg-<%= failure.priority_class %>"><%= failure.priority_text %></span>
                      <span class="badge bg-secondary"><%= failure.status %></span>
                    </div>
                  </div>

                  <%# 失敗内容 %>
                  <p class="mb-2"><%= failure.content %></p>

                  <%# メタ情報 %>
                  <div class="text-muted small mb-2">
                    <% if failure.due_date.present? %>
                      <i class="bi bi-calendar"></i>
                      <span class="<%= 'text-danger fw-bold' if failure.overdue? %>">
                        期限: <%= failure.due_date.strftime("%m/%d %H:%M") %>
                      </span>
                      <% if failure.overdue? %>
                        <span class="text-danger ms-1">
                          <i class="bi bi-exclamation-triangle"></i> 期限切れ
                        </span>
                      <% elsif !failure.resolved? %>
                        <span class="text-info ms-1">
                          <i class="bi bi-clock"></i> 残り <%= failure.days_remaining %>日
                        </span>
                      <% end %>
                    <% else %>
                      <i class="bi bi-calendar-x"></i> 期限: 未設定
                    <% end %>
                  </div>

                  <%# タグ %>
                  <% if failure.tags.present? %>
                    <div class="mb-2">
                      <% failure.tags.split(",").each do |tag| %>
                        <span class="badge bg-light text-dark me-1">
                          <i class="bi bi-tag"></i> <%= tag.strip %>
                        </span>
                      <% end %>
                    </div>
                  <% end %>

                  <%# アクションボタン %>
                  <div class="d-flex gap-2 mt-3">
                    <%= link_to failure_path(failure), class: "btn btn-sm btn-outline-primary" do %>
                      <i class="bi bi-eye"></i> 詳細
                    <% end %>

                    <%= link_to edit_failure_path(failure), class: "btn btn-sm btn-outline-secondary" do %>
                      <i class="bi bi-pencil"></i> 編集
                    <% end %>

                    <%= link_to complete_failure_path(failure), method: :patch, data: { turbo_method: :patch }, class: "btn btn-sm btn-outline-#{failure.resolved? ? 'warning' : 'success'}" do %>
                      <i class="bi bi-check-circle"></i> <%= failure.resolved? ? "未完了" : "完了" %>
                    <% end %>

                    <%= link_to failure_path(failure), method: :delete, data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-sm btn-outline-danger" do %>
                      <i class="bi bi-trash"></i> 削除
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="p-5 text-center bg-white">
          <i class="bi bi-inbox display-1 text-muted"></i>
          <p class="text-muted mt-3">失敗が見つかりませんでした。</p>
          <%= link_to "新しい失敗を記録する", new_failure_path, class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>

    <%# 右サイドバー（モバイルでは非表示） %>
    <div class="col-lg-3 d-none d-lg-block">
      <div class="sticky-top" style="top: 20px;">
        <div class="card border-0 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">
              <i class="bi bi-plus-circle"></i> クイックアクション
            </h5>
            <%= link_to new_failure_path, class: "btn btn-primary w-100 mb-2" do %>
              <i class="bi bi-plus-lg"></i> 新しい失敗を記録
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%# モバイル用フローティングボタン %>
<div class="d-lg-none">
  <%= link_to new_failure_path, class: "btn btn-primary btn-lg rounded-circle floating-button shadow" do %>
    <i class="bi bi-plus-lg"></i>
  <% end %>
</div>
